<!DOCTYPE html>
<html lang="ro">
<head>
    <title><%= prod.nume %> - Detalii</title>
    <%- include("../fragmente/head.ejs") %>
    <link href="/resurse/css/produs.css" type="text/css" rel="stylesheet" />
    <script type="text/javascript" src="/resurse/js/produse.js"></script>
    <script type="text/javascript" src="/resurse/js/produse-cos.js"></script>
    <script type="text/javascript" src="/resurse/js/compare.js"></script>

</head>
<body>
    <%- include("../fragmente/header.ejs") %>

    <main>
        
        <section>
            <article id="art-produs">
                <h2><%= prod.nume %></h2>

                <figure class="imag-produs">
                    <img src="/resurse/imagini/pisici/<%= prod.imagine %>" alt="Imagine <%= prod.nume %>" />
                </figure>

                <ul class="detalii-produs">
                    <li><b>Categorie:</b> <i><%= prod.categorie_mare %></i></li>
                    <li><b>Comportament:</b> <i><%= prod.subcategorie %></i></li>
                    <li><b>Preț:</b> <i><%= prod.pret %> lei</i></li>
                    <li><b>Greutate:</b> <i><%= prod.greutate %> kg</i></li>
                    <li><b>Culoare:</b> <i><%= prod.culoare %></i></li>
                    <li><b>Medii de viață:</b> <i><%= prod.medii_viata %></i></li>
                    <li><b>Dată apariție:</b> <i><%= prod.data_aparitie_form %></i></li>
                    <li><b>Hipoalergenic:</b> <i><%= prod.hipoalergenic ? "Da" : "Nu" %></i></li>
                </ul>

                <p class="descriere"><b>Descriere:</b> <%= prod.descriere %></p>
            </article>
            <div class="text-center mt-3">
  <button class="btn btn-primary btn-compare" data-id="<%= prod.id %>" data-nume="<%= prod.nume %>">Compară</button>
</div>

        </section>
        <% if (seturi && Object.keys(seturi).length > 0) { %>
<section class="mt-5">
  <h3 class="text-center text-primary">Seturi din care face parte acest produs</h3>

  <% for(let set of Object.values(seturi)) { %>
    <section class="card-set my-4 p-3 shadow rounded-4 bg-set text-white">
      <h4 class="titlu-set"><%= set.nume %></h4>
      <p class="descriere-set fst-italic"><%= set.descriere %></p>
      <p class="fw-bold text-white">Preț set: <span class="text-success"><%= set.pret %> lei</span></p>

      <div class="row g-4 mt-3">
        <% for(let p of set.produse) { %>
          <div class="col-md-4 col-6 text-center">
            <a href="/produs/<%= p.id %>" class="text-decoration-none text-dark">
              <img src="/resurse/imagini/pisici/<%= p.imagine %>" class="img-produs mb-1 shadow-sm rounded" alt="<%= p.nume %>">
              <p class="fw-semibold"><%= p.nume %></p>
            </a>
          </div>
        <% } %>
      </div>
    </section>
  <% } %>
</section>
<% } %>

    </main>

    <%- include("../fragmente/footer.ejs") %>
</body>
</html>
